{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "myriad:light_containment_door_entity",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/lcdoor"
			},
			"geometry": {
				"default": "geometry.light_containment_door_entity"
			},
			"render_controllers": ["controller.render.default"],
			"animations" : {
				"rotate" : "animation.lcdoor.rotate",
				"lcdoor.closed" : "animation.lcdoor.closed",
				"lcdoor.open" : "animation.lcdoor.open",
				"lcdoor.opening" : "animation.lcdoor.opening",
				"lcdoor.closing" : "animation.lcdoor.closing",
				"lcdoor_controller" : "controller.animation.lcdoor"

			},
			"scripts" : {
				"pre_animation" : [
					"v.rotation = q.property('myriad:rotation');"
				],
				"animate" : [
					"rotate",
					"lcdoor_controller"
				]
			}
		}
